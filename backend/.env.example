# ─── NAVIGO backend environment ──────────────────────────────────────────────
# Copy to .env and fill in. Only JWT_SECRET and DATABASE_URL are required.

# ── Required ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@localhost:5432/navigo

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated extra CORS origins (e.g. the production frontend URL)
ALLOWED_ORIGINS=http://localhost:5173
# Public URL of this backend (used for OAuth callbacks)
PUBLIC_BACKEND_URL=
# Frontend URL to redirect to after social login
REDIRECT_URL=

# ── Admin auto-creation (skipped if unset) ───────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# ── Money: FREE MODE (manual Mobile Money) ───────────────────────────────────
# The NAVIGO MoMo numbers riders deposit to and the admin pays drivers from.
# Top-ups are hidden in the app until at least one number is set.
MOMO_MTN_NUMBER=
MOMO_MTN_NAME=NAVIGO
MOMO_AIRTEL_NUMBER=
MOMO_AIRTEL_NAME=NAVIGO

# ── Money: PAID MODE (optional, later) ───────────────────────────────────────
# Setting the secret key switches /wallet/payment-info mode to 'gateway' and
# enables gateway-verified top-ups and automatic payouts. Empty = free mode.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# Platform commission rate, 0–1 (clamped to 0.05–0.20). Default 0.10 = 10%.
NAVIGO_COMMISSION_RATE=0.10

# ── Matching ──────────────────────────────────────────────────────────────────
# Drivers within this radius of the pickup get the request first (km).
MATCH_RADIUS_KM=12

# ── SMS via Africa's Talking (optional — codes are logged in dev if unset) ───
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=

# ── Email via Gmail/Nodemailer (optional) ────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=

# ── Social login (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── Dev only ─────────────────────────────────────────────────────────────────
# Allow the in-memory mock DB fallback outside development (never use in prod)
USE_MOCK_DB=
