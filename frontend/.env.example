# NAVIGO frontend environment
# Copy to .env.local (or set in your hosting dashboard, e.g. Vercel) and fill in.

# Base URL of the NAVIGO backend.
# Works WITH or WITHOUT the trailing /api — src/config.ts normalizes it,
# and derives both the REST base (…/api) and the socket.io origin (no /api).
VITE_API_URL=http://localhost:5000/api

# Production example:
# VITE_API_URL=https://your-backend.onrender.com/api
